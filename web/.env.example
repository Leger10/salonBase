# --- Base de donnees (MySQL / MariaDB) -------------------------------------
# Local (XAMPP) :
DATABASE_URL="mysql://root:@127.0.0.1:3306/SalonBase"
# Production (Hostinger) : remplacer par les valeurs du panel hPanel
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Better Auth -----------------------------------------------------------
# Secret de signature des sessions : generer avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="remplacer-par-64-caracteres-hex-aleatoires"
# URL publique de l'application (origine du frontend)
BETTER_AUTH_URL="http://localhost:5173"

# --- Supabase (a supprimer quand la migration sera terminee) ---------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Cloudinary (stockage des images et videos) ---------------------------
# Les medias (images jusqu'a 10 Mo, videos jusqu'a 100 Mo) sont envoyes au CDN
# Cloudinary pour ne pas consommer l'espace et la bande passante de Hostinger.
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
# A renseigner AUSSI dans le panneau Hostinger (Variables d'environnement),
# car le fichier .env n'est pas versionne.
CLOUDINARY_URL=""

# --- Secrets fournisseurs de paiement -------------------------------------
# ATTENTION : ces valeurs ne doivent JAMAIS etre prefixees par VITE_.
# Un prefixe VITE_ les compile dans le bundle public et les expose a tous
# les visiteurs. Elles doivent etre utilisees uniquement par l'API Node.
# (Le prefixe VITE_ historique est conserve ici pour le local tant que le
#  frontend n'a pas ete migre ; a supprimer avant la mise en production.)
WAVE_API_KEY=""
ORANGE_MONEY_CLIENT_ID=""
MOOV_MONEY_API_KEY=""
WHATSAPP_API_TOKEN=""
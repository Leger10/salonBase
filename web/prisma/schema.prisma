  receiptNumber      String?      @map("receipt_number") @db.VarChar(100)
  status             String?      @default("completed") @db.VarChar(50)
  employeeId         String?      @map("employee_id") @db.Char(36)
  createdAt          DateTime?    @default(now()) @map("created_at") @db.DateTime(3)
  transactionType    String?      @default("appointment") @map("transaction_type") @db.Text
  customerName       String?      @map("customer_name") @db.Text
  customerPhone      String?      @map("customer_phone") @db.Text
  source             String?      @default("gallery_order") @db.Text
  notes              String?      @db.Text
  customerId         String?      @map("customer_id") @db.Char(36)
  description        String?      @db.Text
  giftCardId         String?      @map("gift_card_id") @db.Char(36)
  ticketId           String?      @map("ticket_id") @db.Char(36)
  discountAmount     Decimal?     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAfterDiscount Decimal?     @default(0) @map("total_after_discount") @db.Decimal(10, 2)
  discountCode       String?      @map("discount_code") @db.VarChar(50)
  promosApplied      Json?        @default("[]") @map("promos_applied")
  appointment        Appointment? @relation("transactions_appointment_id_fkey", fields: [appointmentId], references: [id])
  cashier            Employee?    @relation("transactions_cashier_id_fkey", fields: [cashierId], references: [id])
  client             Client?      @relation("transactions_client_id_fkey", fields: [clientId], references: [id])
  customer           Client?      @relation("transactions_customer_id_fkey", fields: [customerId], references: [id])
  employee           Employee?    @relation("transactions_employee_id_fkey", fields: [employeeId], references: [id])
  giftCard           GiftCard?    @relation("transactions_gift_card_id_fkey", fields: [giftCardId], references: [id], onDelete: SetNull)
  tenant             Tenant       @relation("transactions_tenant_id_fkey", fields: [tenantId], references: [id], onDelete: Cascade)
  ticket             Ticket?      @relation("transactions_ticket_id_fkey", fields: [ticketId], references: [id])

  transactionLines TransactionLine[] @relation("transaction_lines_transaction_id_fkey")

  @@unique([receiptNumber])
  @@index([customerName(length: 191)], map: "idx_transactions_customer_name")
  @@index([customerPhone(length: 191)], map: "idx_transactions_customer_phone")
  @@index([source(length: 191)], map: "idx_transactions_source")
  @@index([status], map: "idx_transactions_status")
  @@index([tenantId, transactionDate], map: "idx_transactions_tenant_date")
  @@map("transactions")
}


// GENERE AUTOMATIQUEMENT - ne pas editer a la main.
// Source : base Supabase (schema public) via information_schema / pg_catalog.
// Regenerer : node gen-schema.mjs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id         String    @id @default(uuid()) @db.Char(36)
  tenantId   String    @map("tenant_id") @db.Char(36)
  userId     String?   @map("user_id") @db.Char(36)
  action     String    @db.VarChar(255)
  entityType String?   @map("entity_type") @db.VarChar(50)
  entityId   String?   @map("entity_id") @db.Char(36)
  metadata   Json?
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(3)
  tenant     Tenant    @relation("activity_logs_tenant_id_fkey", fields: [tenantId], references: [id], onDelete: Cascade)
  user       Profile?  @relation("activity_logs_user_id_fkey", fields: [userId], references: [id])

  @@index([createdAt], map: "idx_activity_logs_created_at")
  @@index([tenantId], map: "idx_activity_logs_tenant")
  @@map("activity_logs")
}

model Appointment {
  id              String    @id @default(uuid()) @db.Char(36)
  tenantId        String    @map("tenant_id") @db.Char(36)
  clientId        String?   @map("client_id") @db.Char(36)
  employeeId      String?   @map("employee_id") @db.Char(36)
  serviceId       String    @map("service_id") @db.Char(36)
  appointmentDate DateTime  @map("appointment_date") @db.Date
  startTime       String    @map("start_time") @db.VarChar(8)
  endTime         String    @map("end_time") @db.VarChar(8)
  status          String?   @default("pending") @db.VarChar(50)
  totalPrice      Decimal?  @map("total_price") @db.Decimal(10, 2)
  prepaidAmount   Decimal?  @default(0) @map("prepaid_amount") @db.Decimal(10, 2)
  paymentStatus   String?   @default("unpaid") @map("payment_status") @db.VarChar(50)
  notes           String?   @db.Text
  rating          Int?
  review          String?   @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.DateTime(3)
  roomId          String?   @map("room_id") @db.Char(36)
  clientName      String?   @map("client_name") @db.Text
  clientEmail     String?   @map("client_email") @db.Text
  clientPhone     String?   @map("client_phone") @db.Text
  bookingNumber   String?   @map("booking_number") @db.Text
  client          Client?   @relation("appointments_client_id_fkey", fields: [clientId], references: [id])
  employee        Employee? @relation("appointments_employee_id_fkey", fields: [employeeId], references: [id])
  room            Room?     @relation("appointments_room_id_fkey", fields: [roomId], references: [id])
  service         Service   @relation("appointments_service_id_fkey", fields: [serviceId], references: [id])
  tenant          Tenant    @relation("appointments_tenant_id_fkey", fields: [tenantId], references: [id], onDelete: Cascade)

  homeVisits   HomeVisit[]   @relation("home_visits_appointment_id_fkey")
  transactions Transaction[] @relation("transactions_appointment_id_fkey")

  @@index([bookingNumber(length: 191)], map: "idx_appointments_booking_number")
  @@index([clientId], map: "idx_appointments_client")
  @@index([clientEmail(length: 191)], map: "idx_appointments_client_email")
  @@index([employeeId], map: "idx_appointments_employee")
  @@index([roomId], map: "idx_appointments_room")
  @@index([status], map: "idx_appointments_status")
  @@index([tenantId, clientEmail(length: 191)], map: "idx_appointments_tenant_client_email")
  @@index([tenantId, appointmentDate], map: "idx_appointments_tenant_date")
  @@map("appointments")
}

model BookingSequence {
  id         String    @id @default(uuid()) @db.Char(36)

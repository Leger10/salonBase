  updatedAt  DateTime? @default(now()) @map("updated_at") @db.DateTime(3)
  tenant     Tenant    @relation("booking_sequences_tenant_id_fkey", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date], map: "idx_booking_sequences_tenant_date")
  @@map("booking_sequences")
}


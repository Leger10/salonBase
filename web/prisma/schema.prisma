model Ticket {
  id                 String    @id @default(uuid()) @db.Char(36)
  tenantId           String    @map("tenant_id") @db.Char(36)
  clientId           String?   @map("client_id") @db.Char(36)
  clientName         String?   @map("client_name") @db.VarChar(255)
  clientPhone        String?   @map("client_phone") @db.VarChar(50)
  ticketNumber       Int       @map("ticket_number")
  assignedEmployeeId String?   @map("assigned_employee_id") @db.Char(36)
  serviceType        String?   @map("service_type") @db.VarChar(100)
  status             String?   @default("waiting") @db.VarChar(50)
  calledAt           DateTime? @map("called_at") @db.DateTime(3)
  startedAt          DateTime? @map("started_at") @db.DateTime(3)
  completedAt        DateTime? @map("completed_at") @db.DateTime(3)
  createdAt          DateTime? @default(now()) @map("created_at") @db.DateTime(3)
  date               DateTime? @default(now()) @db.Date
  createdBy          String?   @map("created_by") @db.Text
  estimatedDuration  Int?      @map("estimated_duration")
  clientSector       String?   @map("client_sector") @db.Text
  serviceId          String?   @map("service_id") @db.Char(36)
  clientEmail        String?   @map("client_email") @db.Text
  servicePrice       Decimal?  @default(0) @map("service_price") @db.Decimal(12, 2)
  archived           Boolean?  @default(false)
  archivedAt         DateTime? @map("archived_at") @db.DateTime(3)
  transactionId      String?   @map("transaction_id") @db.Char(36)
  paymentStatus      String?   @default("pending") @map("payment_status") @db.Text
  assignedEmployee   Employee? @relation("tickets_assigned_employee_id_fkey", fields: [assignedEmployeeId], references: [id])
  client             Client?   @relation("tickets_client_id_fkey", fields: [clientId], references: [id])
  service            Service?  @relation("tickets_service_id_fkey", fields: [serviceId], references: [id])
  tenant             Tenant    @relation("tickets_tenant_id_fkey", fields: [tenantId], references: [id], onDelete: Cascade)

  transactions Transaction[] @relation("transactions_ticket_id_fkey")

  @@index([date], map: "idx_tickets_date")
  @@index([tenantId, ticketNumber], map: "idx_tickets_number")
  @@index([serviceId], map: "idx_tickets_service_id")
  @@index([servicePrice], map: "idx_tickets_service_price")
  @@index([status], map: "idx_tickets_status")
  @@index([tenantId, date], map: "idx_tickets_tenant_date")
  @@index([tenantId, status], map: "idx_tickets_tenant_status")
  @@map("tickets")
}

